# 手动生成(对照 esp32c3-0.32.2/BUILD.gn 抄改)。
# 背景:gnrt vendor 因 esp-sync-0.2.1 标 edition="2024" 而 cargo metadata 解析整树失败
# (1.84 cargo 不稳定 edition2024),故 c6 PAC 走手动 vendor,本文件按 c3 模板复刻。

import("//build/templates/cargo_crate.gni")

cargo_crate("esp32c6") {
  epoch = "0.23"
  crate_type = "rlib"
  sources = [ "//external/vendor/esp32c6-0.23.0/src/lib.rs" ]
  inputs = []
  edition = "2021"
  # critical-section:esp32c6-0.23.0 的 Cargo.toml 把 critical-section 声明为
  # optional dep(不是 C3 那种空 feature critical-section=[]),按 cargo 语义激活
  # feature="critical-section" 会自动拉入 dep:critical-section,故此处必须 extern。
  # 对照 C3:C3 的 esp32c3-0.32.2 是 critical-section=[] 空 feature,不拉 dep,所以
  # C3 deps 只写 vcell 即可;C6 版本不同,必须显式挂 critical-section-1.2.0。
  deps = [
    "//external/vendor/vcell-0.1.3:vcell",
    "//external/vendor/critical-section-1.2.0:critical_section",
  ]
  features = [ "critical-section" ]

  cargo_pkg_name = "esp32c6"
  cargo_pkg_version = "0.23.0"
  build_root = "//external/vendor/esp32c6-0.23.0/build.rs"
  build_sources = [ "//external/vendor/esp32c6-0.23.0/build.rs" ]

  rustflags = [
    "--cap-lints=allow",  # Suppress all warnings in crates.io crates
  ]
}
